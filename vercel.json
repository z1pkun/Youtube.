{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/download.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/download",
      "destination": "/api/download"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
